<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <!-- Album Art -->
        <ImageView
            android:id="@+id/album_art"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/primary_200"
            android:contentDescription="@string/player_title"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Widget.FlexMusicPlayer.AlbumArt" />

        <!-- Song Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Song Title -->
            <TextView
                android:id="@+id/song_title"
                style="@style/TextAppearance.FlexMusicPlayer.SongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Song Title" />

            <!-- Artist Name -->
            <TextView
                android:id="@+id/artist_name"
                style="@style/TextAppearance.FlexMusicPlayer.SongArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Artist Name" />

        </LinearLayout>

        <!-- Duration -->
        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="3:45" />

        <!-- Options Button -->
        <ImageButton
            android:id="@+id/options_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
