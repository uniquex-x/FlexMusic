<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_app_badge">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_music_note"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnBackground"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_notifications"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_notifications"
                android:src="@drawable/ic_notifications"
                app:tint="@color/primary_500" />

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_title"
                android:src="@drawable/ic_settings"
                app:tint="@color/primary_500" />

            <ImageButton
                android:id="@+id/btn_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_avatar_badge"
                android:contentDescription="@string/nav_my"
                android:padding="10dp"
                android:src="@drawable/ic_person"
                app:tint="@color/primary_700" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_bar_container"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/card_background_light"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8E3F6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search"
                    app:tint="#9D98B8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/home_mock_query"
                    android:textColor="#635E7A"
                    android:textSize="15sp" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_daily_recommend_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_daily_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_daily_recommend_tab"
                    android:textColor="@color/primary_500"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/tab_daily_recommend_indicator"
                    android:layout_width="88dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/primary_500" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_trending_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_trending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_trending_tab"
                    android:textColor="#8B88A1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/tab_trending_indicator"
                    android:layout_width="64dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/primary_500"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_top_list_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tab_top_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_top_list_tab"
                    android:textColor="#8B88A1"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:id="@+id/tab_top_list_indicator"
                    android:layout_width="58dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/primary_500"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/primary_recommend_card"
                    android:layout_width="170dp"
                    android:layout_height="220dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="#F3F1F8"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/primary_recommend_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_daily_recommend_tab"
                            android:textAllCaps="true"
                            android:textColor="#8B88A1"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/primary_recommend_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="@string/home_weekly_discovery"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/primary_recommend_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/home_weekly_discovery_subtitle"
                            android:textColor="#8B88A1"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/secondary_recommend_card"
                    android:layout_width="170dp"
                    android:layout_height="220dp"
                    app:cardBackgroundColor="#A36A34"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/secondary_recommend_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_daily_recommend_tab"
                            android:textAllCaps="true"
                            android:textColor="#F6E4D0"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/secondary_recommend_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="@string/home_modern_jazz"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/secondary_recommend_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/home_modern_jazz_subtitle"
                            android:textColor="#F6E4D0"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_browse_categories"
                android:textColor="?attr/colorOnBackground"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/browse_view_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_view_all"
                android:textColor="@color/primary_500"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="2"
            android:rowCount="2">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/browse_category_pop_card"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#7F44EC"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/browse_category_pop_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/home_category_pop"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/browse_category_rock_card"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                android:layout_marginBottom="8dp"
                app:cardBackgroundColor="#FF5A2E"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/browse_category_rock_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/home_category_rock"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/browse_category_electronic_card"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="#2B8FFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/browse_category_electronic_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/home_category_electronic"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/browse_category_hits_card"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#14B38D"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/browse_category_hits_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:text="@string/home_category_hits"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
