<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- App Bar with Search -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <!-- Search Bar in Toolbar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_bar_container"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginEnd="48dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorOnSurface"
                        android:alpha="0.6" />

                    <TextView
                        android:id="@+id/search_hint_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/search_hint"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.6"
                        android:textSize="14sp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- User Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/user_info_card"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/success_color"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/user_info_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/main_page_user_info"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Navigation Buttons Grid -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:padding="12dp"
                    android:rowCount="2">

                    <!-- Favorites Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_favorites"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:layout_column="0"
                        android:layout_columnWeight="1"
                        android:layout_row="0"
                        android:text="@string/main_page_favorites"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_favorite"
                        app:iconGravity="textStart" />

                    <!-- Recent Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_recent"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:layout_column="1"
                        android:layout_columnWeight="1"
                        android:layout_row="0"
                        android:text="@string/main_page_recent"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_recent"
                        app:iconGravity="textStart" />

                    <!-- Local Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_local"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:layout_column="0"
                        android:layout_columnWeight="1"
                        android:layout_row="1"
                        android:text="@string/main_page_local"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_local"
                        app:iconGravity="textStart" />

                    <!-- Transcode Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_transcode"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:layout_column="1"
                        android:layout_columnWeight="1"
                        android:layout_row="1"
                        android:text="@string/main_page_transcode"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_transcode"
                        app:iconGravity="textStart" />

                </GridLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/dividerVertical"
                android:layout_marginBottom="16dp" />

            <!-- Playlists Section Title -->
            <TextView
                style="@style/TextAppearance.FlexMusicPlayer.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/main_page_playlists_title" />

            <!-- Playlists List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlists_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_playlist_vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
