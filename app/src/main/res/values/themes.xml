<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FlexMusicPlayer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_500</item>
        <item name="colorPrimaryVariant">@color/primary_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary_500</item>
        <item name="colorSecondaryVariant">@color/secondary_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background colors -->
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:colorBackground">@color/background_light</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_700</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <!-- Material components -->
        <item name="materialCardViewStyle">@style/Widget.FlexMusicPlayer.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.FlexMusicPlayer.BottomNavigation</item>
        <item name="toolbarStyle">@style/Widget.FlexMusicPlayer.Toolbar</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Card style -->
    <style name="Widget.FlexMusicPlayer.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background_light</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!-- Bottom Navigation style -->
    <style name="Widget.FlexMusicPlayer.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemBackground">@null</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Toolbar style -->
    <style name="Widget.FlexMusicPlayer.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Bottom nav color selector -->
    <style name="bottom_nav_color">
        <item name="android:textColorSecondary">@color/gray_600</item>
    </style>

    <!-- Player Mini Bar -->
    <style name="Widget.FlexMusicPlayer.PlayerMiniBar" parent="">
        <item name="android:background">@color/player_bar_background</item>
        <item name="android:elevation">8dp</item>
    </style>

    <!-- Song Item Style -->
    <style name="Widget.FlexMusicPlayer.SongItem" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_background_light</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Section Title Style -->
    <style name="TextAppearance.FlexMusicPlayer.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Song Title Style -->
    <style name="TextAppearance.FlexMusicPlayer.SongTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Song Artist Style -->
    <style name="TextAppearance.FlexMusicPlayer.SongArtist" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:alpha">0.7</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Album Art Style -->
    <style name="Widget.FlexMusicPlayer.AlbumArt" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Setting Item Style -->
    <style name="Widget.FlexMusicPlayer.SettingItem" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/transparent</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">0dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>
</resources>